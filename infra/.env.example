# Copy to infra/.env and replace EVERY value. Never commit infra/.env.
# Generate secrets e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
GMS_DB_ADMIN_USER=gms_admin
GMS_DB_ADMIN_PASSWORD=CHANGE_ME_long_random
GMS_DB_APP_USER=gms_app
GMS_DB_APP_PASSWORD=CHANGE_ME_long_random_min_16
GMS_JWT_SECRET=CHANGE_ME_at_least_32_random_characters
GMS_S3_ACCESS_KEY=gms-objects
GMS_S3_SECRET_KEY=CHANGE_ME_long_random
GMS_API_PORT=8000
GMS_WEB_PORT=3000
